# /etc/shack-services/alerts.env -- where shack-watch sends its alerts.
#   sudo install -D -m 600 alerts.env.example /etc/shack-services/alerts.env
# then edit it. It can be the same ntfy topic as hf-alerts (copy NTFY_URL from
# ~/.config/hf-alerts/hf-alerts.env). Root-only: the topic name is the secret.
#NTFY_URL=https://ntfy.sh/CHANGE-ME-long-and-random
#NTFY_TOKEN=
#NTFY_CLICK=https://ag7jc.com
