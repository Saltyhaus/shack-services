# ~/.config/hf-alerts/hf-alerts.env -- every line is optional.
# chmod 600 it if you put an ntfy token in here.

# mercury-connector's -e events file
#EVENTS_FILE=/home/youruser/hf_spool/events.jsonl

# what each event does: any of desktop, sound, push
#NOTIFY_MESSAGE=desktop,sound,push
#NOTIFY_ECHO=desktop,sound

# Phone push through ntfy. Install the ntfy app, subscribe to the same topic.
# On ntfy.sh anyone who knows the topic name can read it: make it long and random.
#NTFY_URL=https://ntfy.sh/hfcontact-CHANGE-ME-to-something-long-and-random
#NTFY_TOKEN=
#NTFY_CLICK=

# Sound. Run `hf_alerts.py --sinks` to see your outputs.
#SOUND_SINK=
# never play on these (a radio's sound card can key the transmitter through VOX)
#RADIO_SINKS=CODEC,C-Media,Burr-Brown,Digirig
# no sound between these hours (notifications and push still go)
#QUIET_HOURS=22-7
#CW_WPM=20
#CW_HZ=650
#VOLUME=0.5
